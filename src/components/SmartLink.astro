---
import { isExternalUrl, resolveUrl } from "../lib/urls";

interface Props {
  href: string;
  class?: string;
  "aria-current"?: "page";
  "aria-label"?: string;
}

const { href, class: className, "aria-current": ariaCurrent, "aria-label": ariaLabel } = Astro.props;
const external = isExternalUrl(href);
const resolved = resolveUrl(href, import.meta.env.BASE_URL);
---

<a class={className} href={resolved} aria-current={ariaCurrent} aria-label={ariaLabel} target={external ? "_blank" : undefined} rel={external ? "noreferrer" : undefined}>
  <slot />
  {external && <><span aria-hidden="true"> ↗</span><span class="sr-only"> (site externe, nouvel onglet)</span></>}
</a>
