---
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props {
  slug: string;
  title: string;
  intro: string;
  image?: { src: string; alt: string; decorative: boolean };
}

const { slug, title, intro, image } = Astro.props;
const imageUrl = image ? `${import.meta.env.BASE_URL}${image.src.replace(/^\/+/, "")}`.replace(/\/{2,}/g, "/") : "";
---

<Breadcrumbs slug={slug} title={title} />
<header class:list={["page-hero", image && "page-hero-with-image"]}>
  {image && <img src={imageUrl} alt={image.decorative ? "" : image.alt} width="1600" height="700" />}
  <div class="page-hero-shade" aria-hidden="true"></div>
  <div class="container page-hero-content">
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
</header>
