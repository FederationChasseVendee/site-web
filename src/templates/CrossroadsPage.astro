---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PageHeader from "../components/PageHeader.astro";
import SmartLink from "../components/SmartLink.astro";
import { normalizeSlug } from "../lib/content";

interface Props {
  entry: CollectionEntry<"crossroads">;
  slug: string;
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const { title, intro, hero, cards, childrenFrom } = entry.data;
const generatedCards = [];

if (childrenFrom === "articles") {
  generatedCards.push(...(await getCollection("articles")).map((child) => ({
    title: child.data.title,
    text: child.data.summary,
    url: `${normalizeSlug(child.id)}/`,
  })));
} else if (childrenFrom === "species") {
  generatedCards.push(...(await getCollection("species")).map((child) => ({
    title: child.data.name,
    text: child.data.identification,
    url: `${normalizeSlug(child.id)}/`,
  })));
} else if (childrenFrom === "trainings") {
  generatedCards.push(...(await getCollection("trainings")).map((child) => ({
    title: child.data.title,
    text: child.data.summary,
    url: `${normalizeSlug(child.id)}/`,
  })));
} else if (childrenFrom === "indexes") {
  generatedCards.push(...(await getCollection("indexes")).filter((child) => normalizeSlug(child.id).startsWith(`${slug}/`)).map((child) => ({
    title: child.data.title,
    text: child.data.intro,
    url: `${normalizeSlug(child.id)}/`,
  })));
}

const allCards = [...cards, ...generatedCards]
  .filter((card, index, list) => list.findIndex((candidate) => candidate.url === card.url) === index);
---

<PageHeader {slug} {title} {intro} image={hero} />
<div class="container content-layout">
  <article class="prose"><Content /></article>
  <section aria-label={`Accès proposés dans ${title}`}>
    <div class="card-grid">
      {allCards.map((card) => (
        <article class="link-card">
          <h2><SmartLink href={card.url}>{card.title}</SmartLink></h2>
          <p>{card.text}</p>
        </article>
      ))}
    </div>
  </section>
</div>
