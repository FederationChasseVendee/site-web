---
import { render, type CollectionEntry } from "astro:content";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ResourceLinks from "../components/ResourceLinks.astro";

interface Props {
  entry: CollectionEntry<"articles">;
  slug: string;
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const { title, summary, date, category, image, documents, expiresAt, archived } = entry.data;
const formatDate = (value: Date) => new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" }).format(value);
const imageUrl = image ? `${import.meta.env.BASE_URL}${image.src.replace(/^\/+/, "")}`.replace(/\/{2,}/g, "/") : "";
const expired = expiresAt && expiresAt < new Date();
---

<Breadcrumbs {slug} {title} />
<article>
  <header class="article-header container">
    <p class="eyebrow">{category}</p>
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    <p class="meta">Publié le <time datetime={date.toISOString()}>{formatDate(date)}</time></p>
    {(archived || expired) && <p class="status-message" role="status">Cette information est archivée. Vérifiez qu’elle est encore applicable.</p>}
    {image && <img src={imageUrl} alt={image.decorative ? "" : image.alt} width="1200" height="675" />}
  </header>
  <div class="container content-layout">
    <div class="prose"><Content /></div>
    <ResourceLinks title="Documents associés" items={documents} />
  </div>
</article>
