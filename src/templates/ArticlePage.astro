---
import { render, type CollectionEntry } from "astro:content";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ResourceLinks from "../components/ResourceLinks.astro";

interface Props {
  entry: CollectionEntry<"articles">;
  slug: string;
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const { title, summary, date, category, image, documents, expiresAt, archived } = entry.data;
const formatDate = (value: Date) => new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" }).format(value);
const imageUrl = image ? `${import.meta.env.BASE_URL}${image.src.replace(/^\/+/, "")}`.replace(/\/{2,}/g, "/") : "";
const expired = expiresAt && expiresAt < new Date();
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  mainEntityOfPage: canonical.href,
  publisher: {
    "@type": "Organization",
    name: "Fédération Départementale des Chasseurs de la Vendée",
    url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  },
  ...(image ? { image: new URL(imageUrl, Astro.site).href } : {}),
};
---

<Breadcrumbs {slug} {title} />
<article>
  <header class="article-header container">
    <p class="eyebrow">{category}</p>
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    <p class="meta">Publié le <time datetime={date.toISOString()}>{formatDate(date)}</time></p>
    {(archived || expired) && <p class="status-message" role="status">Cette information est archivée. Vérifiez qu’elle est encore applicable.</p>}
    {image && (
      <img
        src={imageUrl}
        alt={image.decorative ? "" : image.alt}
        width={image.width ?? 1200}
        height={image.height ?? 675}
        fetchpriority="high"
        decoding="async"
      />
    )}
  </header>
  <div class="container content-layout">
    <div class="prose"><Content /></div>
    <ResourceLinks title="Documents associés" items={documents} />
  </div>
</article>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
