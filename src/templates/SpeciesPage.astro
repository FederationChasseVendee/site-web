---
import type { CollectionEntry } from "astro:content";
import PageHeader from "../components/PageHeader.astro";

interface Props {
  entry: CollectionEntry<"species">;
  slug: string;
}

const { entry, slug } = Astro.props;
const data = entry.data;
const sections = [
  ["Identification", data.identification],
  ["Habitat", data.habitat],
  ["Alimentation", data.diet],
  ["Reproduction", data.reproduction],
  ["Répartition", data.distribution],
  ["Statut et menaces", data.statusAndThreats],
];
---

<PageHeader {slug} title={data.name} intro={data.category} image={data.image} />
<div class="container content-layout">
  <dl class="species-details">
    {sections.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
  </dl>
  {data.gallery.length > 0 && (
    <section aria-labelledby="gallery-title">
      <h2 id="gallery-title">Galerie</h2>
      <div class="gallery">
        {data.gallery.map((image) => (
          <img src={`${import.meta.env.BASE_URL}${image.src.replace(/^\/+/, "")}`} alt={image.decorative ? "" : image.alt} width="600" height="400" loading="lazy" />
        ))}
      </div>
    </section>
  )}
</div>
