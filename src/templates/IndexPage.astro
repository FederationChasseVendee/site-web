---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PageHeader from "../components/PageHeader.astro";
import SmartLink from "../components/SmartLink.astro";
import { normalizeSlug } from "../lib/content";

interface Props {
  entry: CollectionEntry<"indexes">;
  slug: string;
}

interface IndexItem {
  title: string;
  text: string;
  meta?: string;
  url?: string;
  address?: string;
  phone?: string;
  email?: string;
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const items: IndexItem[] = [];

if (data.source === "articles") {
  const entries = await getCollection("articles", ({ data: article }) => !data.category || article.category === data.category);
  items.push(...entries
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map((item) => ({ title: item.data.title, text: item.data.summary, meta: item.data.category, url: `${normalizeSlug(item.id)}/` })));
} else if (data.source === "species") {
  const entries = await getCollection("species", ({ data: species }) => !data.category || species.category === data.category);
  items.push(...entries.map((item) => ({ title: item.data.name, text: item.data.identification, meta: item.data.category, url: `${normalizeSlug(item.id)}/` })));
} else if (data.source === "trainings") {
  items.push(...(await getCollection("trainings")).map((item) => ({ title: item.data.title, text: item.data.summary, meta: item.data.duration, url: `${normalizeSlug(item.id)}/` })));
} else if (data.source === "documents") {
  const entries = await getCollection("documents", ({ data: document }) => !data.category || document.category === data.category);
  items.push(...entries.map((item) => ({
    title: item.data.title,
    text: item.data.description,
    meta: [item.data.fileType, item.data.fileSize].filter(Boolean).join(" · "),
    url: item.data.file,
  })));
} else if (data.source === "faqs") {
  items.push(...(await getCollection("faqs"))
    .sort((a, b) => a.data.order - b.data.order)
    .map((item) => ({ title: item.data.question, text: item.data.answer, meta: item.data.category })));
} else if (data.source === "glossary") {
  items.push(...(await getCollection("glossary"))
    .sort((a, b) => a.data.term.localeCompare(b.data.term, "fr"))
    .map((item) => ({ title: item.data.term, text: item.data.definition })));
} else {
  const entries = await getCollection(
    "directories",
    ({ data: directory }) => !data.category
      || directory.category.toLocaleLowerCase("fr").includes(data.category.toLocaleLowerCase("fr")),
  );
  items.push(...entries
    .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name, "fr"))
    .map((item) => ({
    title: item.data.name,
    text: item.data.description,
    meta: [item.data.role, item.data.category].filter(Boolean).join(" · "),
    url: item.data.website,
    address: item.data.address,
    phone: item.data.phone,
    email: item.data.email,
  })));
}
---

<PageHeader {slug} title={data.title} intro={data.intro} image={data.hero} />
<div class="container content-layout">
  <article class="prose"><Content /></article>
  {data.links.length > 0 && (
    <nav class="section-links" aria-label="Autres ressources">
      {data.links.map((link) => <SmartLink class="button button-outline" href={link.url}>{link.label}</SmartLink>)}
    </nav>
  )}
  {items.length > 0 ? (
    <div class:list={["index-items", data.display === "cards" && "card-grid"]}>
      {items.map((item) => (
        <article class="index-item">
          {item.meta && <p class="eyebrow">{item.meta}</p>}
          <h2>{item.url ? <SmartLink href={item.url}>{item.title}</SmartLink> : item.title}</h2>
          <p>{item.text}</p>
          {item.address && <p>{item.address}</p>}
          {(item.phone || item.email) && (
            <p class="directory-contacts">
              {item.phone && <SmartLink href={`tel:${item.phone.replace(/[^\d+]/g, "")}`}>{item.phone}</SmartLink>}
              {item.phone && item.email && <span aria-hidden="true"> · </span>}
              {item.email && <SmartLink href={`mailto:${item.email}`}>{item.email}</SmartLink>}
            </p>
          )}
        </article>
      ))}
    </div>
  ) : <p class="empty-message">{data.emptyMessage}</p>}
</div>
