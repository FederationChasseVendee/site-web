---
import { render, type CollectionEntry } from "astro:content";
import PageHeader from "../components/PageHeader.astro";
import ResourceLinks from "../components/ResourceLinks.astro";
import SmartLink from "../components/SmartLink.astro";

interface Props {
  entry: CollectionEntry<"standardPages">;
  slug: string;
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const { title, intro, hero, documents, links, cta } = entry.data;
---

<PageHeader {slug} {title} {intro} image={hero} />
<div class="container content-layout">
  <article class="prose"><Content /></article>
  <ResourceLinks title="Documents à télécharger" items={documents} />
  <ResourceLinks title="Liens utiles" items={links} />
</div>
{cta && (
  <aside class="cta-panel">
    <div class="container">
      <div>
        <h2>{cta.title}</h2>
        {cta.text && <p>{cta.text}</p>}
      </div>
      <SmartLink class="button button-light" href={cta.action.url}>{cta.action.label}</SmartLink>
    </div>
  </aside>
)}
